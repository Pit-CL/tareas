#!/usr/bin/env bash
# tareas — lanzador de la TUI.
#
# Hace dos cosas:
#   1. Prepara (una sola vez) un venv aislado con la versión de textual que la app pide.
#   2. Reinicia la app si se cae, para que el pane donde vive nunca quede muerto.
#
# Compatible con el bash 3.2 que trae macOS: sin mapfile, sin arreglos asociativos.
set -u

VERSION_TEXTUAL="8.2.8"
VENV="${TAREAS_VENV:-$HOME/.venvs/tareas}"

# Resolvemos symlinks a mano: `readlink -f` no existe en el BSD readlink de macOS.
_resolver() {
  _archivo="$1"
  while [ -L "$_archivo" ]; do
    _destino=$(readlink "$_archivo")
    case "$_destino" in
      /*) _archivo="$_destino" ;;
      *)  _archivo="$(dirname "$_archivo")/$_destino" ;;
    esac
  done
  printf '%s\n' "$_archivo"
}

GUION=$(_resolver "$0")
RAIZ=$(cd "$(dirname "$GUION")/.." && pwd)

if ! command -v python3 >/dev/null 2>&1; then
  echo "tareas: necesita python3 (3.11 o superior)" >&2
  exit 2
fi

if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
  echo "tareas: necesita Python 3.11 o superior (el actual es $(python3 -V 2>&1))" >&2
  exit 2
fi

# ---- venv ----------------------------------------------------------------------------
instalado=""
if [ -x "$VENV/bin/python" ]; then
  instalado=$("$VENV/bin/python" -c 'import textual; print(textual.__version__)' 2>/dev/null) || instalado=""
fi

if [ "$instalado" != "$VERSION_TEXTUAL" ]; then
  echo "tareas: preparando el entorno en $VENV (solo esta vez)…"
  if [ ! -x "$VENV/bin/python" ] && ! python3 -m venv "$VENV"; then
    echo "tareas: no pude crear el venv en $VENV" >&2
    exit 2
  fi
  "$VENV/bin/python" -m pip install --quiet --upgrade pip
  if ! "$VENV/bin/python" -m pip install --quiet "textual==$VERSION_TEXTUAL"; then
    echo "tareas: falló la instalación de textual==$VERSION_TEXTUAL" >&2
    exit 2
  fi
fi

# ---- bucle de reinicio ---------------------------------------------------------------
# El código de la app se lee del repo, así que un `git pull` basta para actualizar.
export PYTHONPATH="$RAIZ/src${PYTHONPATH:+:$PYTHONPATH}"

while true; do
  "$VENV/bin/python" -m tareas_tui "$@"
  salida=$?
  case "$salida" in
    0)   exit 0 ;;                       # salida normal
    2)   exit 2 ;;                       # configuración o requisitos: reintentar no sirve
    130) exit 130 ;;                     # ctrl-c
    143) exit 143 ;;                     # SIGTERM
  esac
  echo "tareas: la app terminó con código $salida; reinicio en 2s (ctrl-c para salir)…" >&2
  sleep 2
done
