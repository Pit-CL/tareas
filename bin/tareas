#!/usr/bin/env bash
# tareas — lanzador de la TUI.
#
# Hace dos cosas:
#   1. Prepara (una sola vez) un venv aislado con la versión de textual que la app pide.
#   2. Reinicia la app si se cae, para que el pane donde vive nunca quede muerto.
#
# Compatible con el bash 3.2 que trae macOS: sin mapfile, sin arreglos asociativos.
set -u

VERSION_TEXTUAL="8.2.8"
VENV="${TAREAS_VENV:-$HOME/.venvs/tareas}"

# Resolvemos symlinks a mano: `readlink -f` no existe en el BSD readlink de macOS.
_resolver() {
  _archivo="$1"
  while [ -L "$_archivo" ]; do
    _destino=$(readlink "$_archivo")
    case "$_destino" in
      /*) _archivo="$_destino" ;;
      *)  _archivo="$(dirname "$_archivo")/$_destino" ;;
    esac
  done
  printf '%s\n' "$_archivo"
}

GUION=$(_resolver "$0")
RAIZ=$(cd "$(dirname "$GUION")/.." && pwd)

if ! command -v python3 >/dev/null 2>&1; then
  echo "tareas: needs python3 (3.11 or higher)" >&2
  exit 2
fi

if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
  echo "tareas: needs Python 3.11 or higher (current is $(python3 -V 2>&1))" >&2
  exit 2
fi

# ---- venv ----------------------------------------------------------------------------
# La comprobación se hace mirando el dist-info que deja pip, no importando textual:
# ese `python -c 'import textual'` costaba ~0,15 s en CADA arranque (un intérprete
# entero, más rich y el árbol de textual, solo para leer __version__).
#
# El atajo solo vale si el venv tiene UNA sola lib/pythonX.Y: cuando el python del
# sistema sube de versión, el venv queda con la carpeta vieja (con su textual
# instalado) más la nueva vacía, y el intérprete ya usa la nueva. Ahí el dist-info
# viejo mentiría «ya está instalado», el import fallaría y `bin/tareas` relanzaría
# la app en bucle -justo la recuperación automática que el probe por import daba
# gratis-. Con dos carpetas (o ninguna) se cae al import, que es la respuesta
# autorizada; el caso normal es una sola y no lanza ningún proceso.
instalado=""
if [ -x "$VENV/bin/python" ]; then
  _libs=""
  _cuantas=0
  for _lib in "$VENV"/lib/python*/site-packages; do
    if [ -d "$_lib" ]; then
      _libs="$_lib"
      _cuantas=$((_cuantas + 1))
    fi
  done
  if [ "$_cuantas" -eq 1 ] && [ -d "$_libs/textual-$VERSION_TEXTUAL.dist-info" ]; then
    instalado="$VERSION_TEXTUAL"
  else
    instalado=$("$VENV/bin/python" -c 'import textual; print(textual.__version__)' 2>/dev/null) || instalado=""
  fi
fi

if [ "$instalado" != "$VERSION_TEXTUAL" ]; then
  echo "tareas: setting up the environment in $VENV (only this once)…"
  if [ ! -x "$VENV/bin/python" ] && ! python3 -m venv "$VENV"; then
    echo "tareas: couldn't create the venv in $VENV" >&2
    exit 2
  fi
  "$VENV/bin/python" -m pip install --quiet --upgrade pip
  if ! "$VENV/bin/python" -m pip install --quiet "textual==$VERSION_TEXTUAL"; then
    echo "tareas: failed to install textual==$VERSION_TEXTUAL" >&2
    exit 2
  fi
fi

# ---- bucle de reinicio ---------------------------------------------------------------
# El código de la app se lee del repo, así que un `git pull` basta para actualizar.
export PYTHONPATH="$RAIZ/src${PYTHONPATH:+:$PYTHONPATH}"

while true; do
  "$VENV/bin/python" -m tareas_tui "$@"
  salida=$?
  case "$salida" in
    0)   exit 0 ;;                       # salida normal
    2)   exit 2 ;;                       # configuración o requisitos: reintentar no sirve
    130) exit 130 ;;                     # ctrl-c
    143) exit 143 ;;                     # SIGTERM
  esac
  echo "tareas: the app exited with code $salida; restarting in 2s (ctrl-c to quit)…" >&2
  sleep 2
done
